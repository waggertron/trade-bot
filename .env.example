# Interactive Brokers
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# Kraken
KRAKEN_API_KEY=<your-kraken-api-key>
KRAKEN_API_SECRET=<your-kraken-api-secret>

# AI
ANTHROPIC_API_KEY=<your-anthropic-api-key>
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Discord
DISCORD_BOT_TOKEN=<your-discord-bot-token>
DISCORD_CHANNEL_ID=<your-discord-channel-id>

# Database
# Local dev (SQLite): sqlite+aiosqlite:///trade_bot.db
# Production (Postgres): postgresql+asyncpg://user:pass@localhost:5432/tradebot
DATABASE_URL=postgresql+asyncpg://tradebot:tradebot@localhost:5432/tradebot

# PostgreSQL (used by Docker Compose)
POSTGRES_USER=tradebot
POSTGRES_PASSWORD=tradebot
POSTGRES_DB=tradebot

# Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=<your-jwt-secret-key>

# OAuth (optional - leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Application settings (alternative to config/settings.yaml)
TRADE_BOT_MODE=paper
TRADE_BOT_CRYPTO_SYMBOLS=BTC/USD,ETH/USD
TRADE_BOT_STOCK_SYMBOLS=
TRADE_BOT_DASHBOARD_PORT=8080

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
